# Set these in Coolify at runtime. Mark the token as a secret.
DISCORD_TOKEN=
GUILD_ID=
# Optional labs server. Configure its ID in Coolify runtime variables.
LAB_GUILD_ID=
# Optional at startup (derived from the logged-in bot); required for npm run commands.
CLIENT_ID=

ROBLOX_GROUP_ID=36060455
USER_AGENT=

# Optional channels in the primary server.
GENERAL_CHANNEL_ID=
COMMANDS_CHANNEL_ID=

# Internal health port.
PORT=8080

